generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id    String @id @default(uuid())
  nome  String
  email String @unique
  senha String
  isAdmin  Boolean  @default(false)

  livros    Livro[]

  @@map("Usuario")
}


model Livro{
  id        String   @id @default(uuid())
  titulo    String
  autor     String
  genero    String
  status    Boolean  @default(false) 

  UserId String?  
  usuario   Usuario? @relation(fields: [UserId], references: [id])

}
