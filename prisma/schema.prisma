generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id    String @id @default(uuid())
  nome  String
  senha String
}

model livro{
  id    String @id @default(uuid())
  titulo String
  autor  String
  genero String
  status Boolean
}
